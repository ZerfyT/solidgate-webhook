{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solidgate Webhook",
  "mainBinaryName": "solidgate-webhook",
  "version": "0.2.1",
  "identifier": "com.nipun.solidgate-webhook",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Solidgate Webhook",
        "width": 800,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "homepage": "https://github.com/ZerfyT/solidgate-webhook",
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}